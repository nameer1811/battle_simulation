<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[globals [
  texian-casualties
  mexican-casualties
  mexican-captured
  texian-captured
  mexican-readiness
  battle-phase
  surprise-ticks
  battle-over?
  battle-duration
  combat-start-tick
  texian-win?
  mexican-side-morale
  texian-side-morale
  ridgeline-x
  ridgeline-slope
  ridgeline-breached?
]

breed [ texians texian ]
breed [ mexicans mexican ]
breed [ texian-cannons texian-cannon ]
breed [ mexican-cannons mexican-cannon ]

texians-own [ health morale state suppressed-ticks attack-lane regiment ]
mexicans-own [ health morale state activation-delay suppressed-ticks is-cos-troop? fatigue-modifier ]
mexican-cannons-own [ shots-left reload-timer ]
texian-cannons-own [ reload-timer ]

patches-own [
  terrain-type
  move-mod
  cover-mod
  is-barricade?
  barricade-health
]

to-report random-open-patch-in [min-x max-x min-y max-y]
  report one-of patches with [
    pxcor >= min-x and pxcor <= max-x and
    pycor >= min-y and pycor <= max-y and
    terrain-type = "open"
  ]
end

to place-on-open-patch [min-x max-x min-y max-y]
  let landing-patch random-open-patch-in min-x max-x min-y max-y
  if landing-patch != nobody [
    move-to landing-patch
    set xcor xcor + (random-float 3 - 1.5)
    set ycor ycor + (random-float 3 - 1.5)
  ]
end

to place-in-camp [cx cy rx ry]
  let target one-of patches with [
    terrain-type = "open" and
    pxcor >= -8 and
    (((pxcor - cx) ^ 2) / (rx ^ 2) + ((pycor - cy) ^ 2) / (ry ^ 2)) < 1.0
  ]
  if target != nobody [
    move-to target
    set xcor xcor + (random-float 4 - 2)
    set ycor ycor + (random-float 4 - 2)
  ]
end

to-report east-of-ridgeline? [x-pos y-pos]
  report x-pos >= (ridgeline-x + (ridgeline-slope * y-pos))
end

to-report battle-time
  if combat-start-tick = 0 [ report "0m 0s" ]
  let t ifelse-value battle-over? [ battle-duration ] [ ticks - combat-start-tick ]
  let total-seconds t * 6
  let mins floor (total-seconds / 60)
  let secs floor (total-seconds mod 60)
  report (word mins "m " secs "s")
end

to setup-patches
  ;; ── Base prairie ──
  ask patches [
    set terrain-type "open"
    set move-mod 1
    set cover-mod 0.05
    set is-barricade? false
    set barricade-health 0
    set plabel ""
    set pcolor 56 + random-float 0.4 - 0.2
  ]

  ;; ── Waterways (single pass per patch) ──
  ;; Three parts: Buffalo Bayou (horizontal), a smooth arc (the bend),
  ;; and San Jacinto River (vertical with S-curves). No right angle.
  ask patches [
    ;; Arc center and radius — this creates the smooth 90° bend
    let arc-cx 86
    let arc-cy 50
    let arc-r 32

    ;; Buffalo Bayou: pronounced meanders at y≈82, west of the arc.
    ;; NetLogo sin() is in DEGREES. For ~1.5 visible S-bends over 266 patches: freq ≈ 2.0
    let bayou-blend min list 1 (max list 0 ((arc-cx - pxcor) / 30))
    let bayou-cy (82
      + bayou-blend * (12 * sin (pxcor * 2.0) + 5 * sin (pxcor * 4.8) + 2 * sin (pxcor * 11))
    )
    let d-bayou abs (pycor - bayou-cy)

    ;; San Jacinto River: big S-curves below the arc, x≈118.
    ;; For ~1 visible S-bend over 130 patches: freq ≈ 2.8
    let river-blend min list 1 (max list 0 ((arc-cy - pycor) / 30))
    let river-cx (118
      + river-blend * (18 * sin (pycor * 2.8) + 8 * sin (pycor * 6.5) + 3 * sin (pycor * 14))
    )
    let d-river abs (pxcor - river-cx)

    ;; Smooth arc connecting bayou to river (quarter circle in upper-right quadrant)
    let d-from-center sqrt ((pxcor - arc-cx) ^ 2 + (pycor - arc-cy) ^ 2)
    let d-arc abs (d-from-center - arc-r)
    let in-corner (pxcor >= arc-cx and pycor >= arc-cy)

    let edge-noise random-float 1.6
    let hw (2.5 + edge-noise)

    let is-bayou (d-bayou < hw and pxcor < (arc-cx + 4))
    let is-river (d-river < hw and pycor < (arc-cy + 4) and pycor > -80)
    let is-arc (d-arc < hw and in-corner)

    if is-bayou or is-river or is-arc [
      set pcolor 104.2 - random-float 0.9
      set terrain-type "lake"
      set move-mod 0
      set cover-mod 0
    ]
  ]

  ;; ── Peggy Lake ──
  ;; South of the Mexican camp, near the river. Irregular marshy lake.
  ask patches with [
    (((pxcor - 70) ^ 2) / 280 + ((pycor + 68) ^ 2) / 180 < 1.0) or
    (((pxcor - 82) ^ 2) / 150 + ((pycor + 76) ^ 2) / 130 < 1.0) or
    (((pxcor - 60) ^ 2) / 120 + ((pycor + 80) ^ 2) / 90 < 1.0) or
    (((pxcor - 76) ^ 2) / 80 + ((pycor + 60) ^ 2) / 70 < 1.0) or
    (((pxcor - 55) ^ 2) / 70 + ((pycor + 72) ^ 2) / 100 < 1.0)
  ] [
    set pcolor 104.5 - random-float 0.7
    set terrain-type "lake"
    set move-mod 0
    set cover-mod 0
  ]
  ;; Ragged fringe
  ask patches with [
    terrain-type = "open" and
    any? (neighbors with [terrain-type = "lake" and pycor < -50]) and
    random-float 1 < 0.42
  ] [
    set pcolor 104.5 - random-float 0.7
    set terrain-type "lake"
    set move-mod 0
    set cover-mod 0
  ]
  ask patches with [
    terrain-type = "open" and
    count (neighbors with [terrain-type = "lake" and pycor < -50]) >= 3 and
    random-float 1 < 0.35
  ] [
    set pcolor 104.5 - random-float 0.7
    set terrain-type "lake"
    set move-mod 0
    set cover-mod 0
  ]

  ;; ── Marshy channel connecting Peggy Lake to San Jacinto River ──
  ;; "Santa Anna's Bayou" — boggy waterway linking the lake to the river system.
  ask patches with [
    terrain-type = "open" and
    pxcor > 80 and pycor < -45 and pycor > -80 and
    abs (pycor - (-62 + 5 * sin (pxcor * 4.5))) < (3 + random-float 2)
  ] [
    set pcolor 104.5 - random-float 0.8
    set terrain-type "lake"
    set move-mod 0
    set cover-mod 0
  ]

  ;; ── Marsh / wetlands ──
  ask patches with [
    terrain-type = "open" and
    any? neighbors with [terrain-type = "lake"] and
    random-float 1 < 0.5
  ] [
    set pcolor 54.3 + random-float 0.6
    set terrain-type "marsh"
    set move-mod 0.7
    set cover-mod 0.10
  ]
  ;; ── Heavy marshland surrounding the Mexican camp ──
  ;; Organic shapes using distance-from-center with per-patch noise.
  ;; Multiple overlapping marsh blobs create natural, irregular wetland.
  ask patches with [terrain-type = "open"] [
    ;; Per-patch noise field: pseudo-random value based on coordinates
    ;; (deterministic so it tiles consistently, uses sin to fake noise)
    let noise-val (sin (pxcor * 37 + pycor * 53) * sin (pxcor * 17 + pycor * 89) + 1) / 2

    let marsh-prob 0

    ;; South marsh lobe: between camp and Peggy Lake
    let d1 distancexy 50 -55
    if d1 < 45 [ set marsh-prob max list marsh-prob (0.75 * (1 - d1 / 45)) ]

    ;; Southeast marsh lobe: wrapping toward Peggy Lake
    let d2 distancexy 70 -50
    if d2 < 35 [ set marsh-prob max list marsh-prob (0.65 * (1 - d2 / 35)) ]

    ;; East marsh: boggy ground between camp and river
    let d3 distancexy 65 -5
    if d3 < 40 [ set marsh-prob max list marsh-prob (0.60 * (1 - d3 / 40)) ]

    ;; Northeast marsh: between camp and bayou
    let d4 distancexy 55 35
    if d4 < 35 [ set marsh-prob max list marsh-prob (0.55 * (1 - d4 / 35)) ]

    ;; North marsh lobe
    let d5 distancexy 40 50
    if d5 < 28 [ set marsh-prob max list marsh-prob (0.50 * (1 - d5 / 28)) ]

    ;; Scattered small boggy patches around the camp perimeter
    let d6 distancexy 30 -30
    if d6 < 30 [ set marsh-prob max list marsh-prob (0.45 * (1 - d6 / 30)) ]

    ;; Use noise to break up edges — threshold varies per patch
    if noise-val < marsh-prob [
      set pcolor 54 + random-float 0.8
      set terrain-type "marsh"
      set move-mod 0.6
      set cover-mod 0.12
    ]
  ]

  ;; ── Tree groves ──
  ;; Small clusters of live oaks near the Texian camp and along the bayou bluff.
  ;; Probability falls off with distance from grove center, creating soft edges.
  ask patches with [terrain-type = "open"] [
    let tree-prob 0
    ;; Texian camp grove (screening oaks)
    let d1 distancexy -142 68
    if d1 < 14 [ set tree-prob max list tree-prob (0.40 * (1 - d1 / 14)) ]
    ;; Small grove south of bayou
    let d2 distancexy -105 62
    if d2 < 8 [ set tree-prob max list tree-prob (0.30 * (1 - d2 / 8)) ]
    ;; Copse near west edge
    let d3 distancexy -165 56
    if d3 < 10 [ set tree-prob max list tree-prob (0.30 * (1 - d3 / 10)) ]
    ;; Tiny cluster mid-field
    let d4 distancexy -80 58
    if d4 < 6 [ set tree-prob max list tree-prob (0.25 * (1 - d4 / 6)) ]

    if random-float 1 < tree-prob [
      set pcolor 54.5 + random-float 0.5
    ]
  ]

  ;; ── Ridgeline ──
  ;; A gentle rise stretching most of the battlefield north-south.
  ask patches with [
    abs (pxcor - (ridgeline-x + round (3 * sin (pycor * 3.5)))) < 1 and
    pycor > -75 and pycor < 60
  ] [
    set pcolor 33.5 + random-float 0.6
    set terrain-type "ridgeline"
    set move-mod 0.9
    set cover-mod 0.24
  ]
  ;; Softer shoulders on either side of the ridge crest
  ask patches with [
    abs (pxcor - (ridgeline-x + round (3 * sin (pycor * 3.5)))) >= 1 and
    abs (pxcor - (ridgeline-x + round (3 * sin (pycor * 3.5)))) < 4 and
    pycor > -75 and pycor < 60
  ] [
    set pcolor 55.2 - random-float 0.4
  ]

  ;; ── Labels ──
  ask patch -60 96 [
    set plabel "BUFFALO BAYOU"
    set plabel-color 3
  ]
  ask patch 132 0 [
    set plabel "SAN JACINTO R."
    set plabel-color 9
  ]
  ask patch 72 -56 [
    set plabel "PEGGY LAKE"
    set plabel-color 9
  ]
  ask patch (ridgeline-x - 4) 40 [
    set plabel "RIDGELINE"
    set plabel-color 33
  ]

  ;; ── Breastwork ──
  ;; Improvised barricade of boxes, baggage, pack saddles, and brush.
  ;; Covers the full Mexican front (~800 yards / 70 patches).
  let bw-x (ridgeline-x + 40)
  ask patches with [
    pxcor >= bw-x and pxcor <= (bw-x + 2 + (ifelse-value (random-float 1 < 0.3) [1] [0])) and
    pycor > (-50 + round (2 * sin (pycor * 7))) and pycor < (25 + round (2 * sin (pycor * 5)))
  ] [
    set pcolor 33 + random-float 0.8
    set terrain-type "barricade"
    set is-barricade? true
    set barricade-health 120
    set move-mod 0.45
    set cover-mod 0.60
  ]
  ask patch (bw-x + 1) 30 [
    set plabel "BREASTWORK"
    set plabel-color 36
  ]

  ;; ── Camp tents (static stamps) ──
  ;; Texian camp: northwest, screened by live oak groves along Buffalo Bayou.
  let tent-positions-tex (list
    (list -152 66) (list -144 68) (list -135 67) (list -127 66)
    (list -154 58) (list -145 60) (list -137 59) (list -128 58)
    (list -149 51) (list -141 52) (list -133 50)
    (list -155 44) (list -146 45) (list -138 43)
  )
  foreach tent-positions-tex [ pos ->
    ask patch (item 0 pos) (item 1 pos) [
      sprout 1 [
        set shape "house"
        set color 48
        set size 5.5
        set heading random 8 - 4
        stamp
        die
      ]
    ]
  ]
  ask patch -140 75 [
    set plabel "TEXIAN CAMP"
    set plabel-color 48
  ]

  ;; Mexican camp: east of breastwork, bordered by marsh and Peggy Lake.
  let tent-positions-mex (list
    (list 5 9) (list 13 10) (list 21 8) (list 29 9)
    (list 3 1) (list 11 -1) (list 20 0) (list 28 1)
    (list 5 -7) (list 14 -9) (list 22 -8) (list 30 -7)
    (list 7 -16) (list 16 -15) (list 24 -17)
    (list 9 -24) (list 18 -25) (list 27 -23)
    (list 7 -33) (list 16 -31) (list 25 -33)
  )
  foreach tent-positions-mex [ pos ->
    ask patch (item 0 pos) (item 1 pos) [
      if terrain-type = "open" or terrain-type = "marsh" [
        sprout 1 [
          set shape "house"
          set color 14
          set size 5.5
          set heading random 8 - 4
          stamp
          die
        ]
      ]
    ]
  ]
  ask patch 18 18 [
    set plabel "MEXICAN CAMP"
    set plabel-color 14
  ]
end

to setup-troops
  let readiness (mexican-concentration / 100)
  let fatigue-norm (cos-fatigue / 100)

  ;; Texian deployment: four distinct horizontal bands matching historical formation
  ;; All start at roughly the same x, advance due east in parallel lines
  let sherman-vol 260
  let burleson-vol 280
  let millard-reg 260
  let lamar-cav 135

  ;; Sherman's Volunteers — northernmost line (2nd Reg, left wing)
  create-texians sherman-vol [
    set color red
    set shape "person"
    place-on-open-patch -162 -120 15 47
    set attack-lane 0
    set regiment 0
    set health 100
    set morale 75 + random-float 20
    set state "fighting"
    set suppressed-ticks 0
  ]

  ;; Burleson's Volunteers / Hockley — upper-middle (1st Reg, center)
  create-texians burleson-vol [
    set color red
    set shape "person"
    place-on-open-patch -160 -118 -18 15
    set attack-lane 0
    set regiment 1
    set health 100
    set morale 75 + random-float 20
    set state "fighting"
    set suppressed-ticks 0
  ]

  ;; Millard's Regulars — lower-middle (center infantry)
  create-texians millard-reg [
    set color red
    set shape "person"
    place-on-open-patch -158 -116 -52 -18
    set attack-lane 0
    set regiment 2
    set health 100
    set morale 75 + random-float 20
    set state "fighting"
    set suppressed-ticks 0
  ]

  ;; Lamar's Cavalry — well south, positioned to sweep around the breastwork (right wing)
  create-texians lamar-cav [
    set color 33
    set shape "horse"
    set size 4
    set heading 100 + random 20
    place-on-open-patch -170 -125 -88 -55
    set attack-lane 1
    set regiment 3
    set health 100
    set morale 80 + random-float 15
    set state "fighting"
    set suppressed-ticks 0
  ]

  ;; Mexican camp — elliptical clusters so no visible rectangles
  ;; Camp center is roughly (10, -8), east of breastwork, west of marsh
  let main-total 750
  let num-concentrated round (main-total * readiness)
  let num-dispersed main-total - num-concentrated

  let front-rank round (num-concentrated * 0.62)
  let reserve-rank num-concentrated - front-rank

  ;; Front rank: tight ellipse just east of breastwork
  create-mexicans front-rank [
    set color violet
    set shape "person"
    place-in-camp 4 -4 12 22
    set health 100
    set morale 50 + (readiness * 30) + random-float 10
    set state "fighting"
    set activation-delay max list 0 (round ((1 - readiness) * 12) + random 4)
    set suppressed-ticks 0
    set is-cos-troop? false
    set fatigue-modifier 0
  ]

  ;; Reserve: overlapping ellipse slightly deeper in camp
  create-mexicans reserve-rank [
    set color violet
    set shape "person"
    place-in-camp 12 -4 14 22
    set health 100
    set morale 48 + (readiness * 30) + random-float 10
    set state "fighting"
    set activation-delay max list 0 (round ((1 - readiness) * 13) + random 5)
    set suppressed-ticks 0
    set is-cos-troop? false
    set fatigue-modifier 0
  ]

  ;; Dispersed main body: large ellipse covering the whole camp
  create-mexicans num-dispersed [
    set color violet
    set shape "person"
    place-in-camp 16 -6 22 32
    set health 100
    set morale 40 + (readiness * 18) + random-float 10
    set state "fighting"
    set activation-delay max list 0 (round ((1 - readiness) * 26) + random 10)
    set suppressed-ticks 0
    set is-cos-troop? false
    set fatigue-modifier 0
  ]

  ;; Cos' reinforcements — southern half of camp
  let cos-total 500
  let cos-concentrated round (cos-total * readiness * (1 - fatigue-norm * 0.5))
  let cos-dispersed cos-total - cos-concentrated

  ;; Cos concentrated: ellipse centered south of main camp
  create-mexicans cos-concentrated [
    set color violet + 2
    set shape "person"
    place-in-camp 16 -28 20 20
    set health 100
    set morale (46 + (readiness * 24) + random-float 10) - (22 * fatigue-norm)
    set state "fighting"
    set activation-delay max list 0 (round ((1 - readiness) * 14) + round (fatigue-norm * 12) + random 5)
    set suppressed-ticks 0
    set is-cos-troop? true
    set fatigue-modifier fatigue-norm
  ]

  ;; Cos dispersed: large ellipse covering south/rear of camp
  create-mexicans cos-dispersed [
    set color violet + 2
    set shape "person"
    place-in-camp 18 -34 24 28
    set health 100
    set morale (40 + (readiness * 16) + random-float 10) - (22 * fatigue-norm)
    set state "fighting"
    set activation-delay max list 0 (round ((1 - readiness) * 26) + round (fatigue-norm * 14) + random 10)
    set suppressed-ticks 0
    set is-cos-troop? true
    set fatigue-modifier fatigue-norm
  ]

  create-texian-cannons 2 [
    set color cyan
    set shape "cannon"
    set size 4
    set heading 90
    place-on-open-patch -112 -78 8 34
    set reload-timer random 8
  ]

  create-mexican-cannons 1 [
    set color orange
    set shape "cannon"
    set size 4
    set heading 270
    place-in-camp 4 -2 8 8
    set shots-left 1
    if random-float 1 < (0.70 - (0.55 * readiness)) [ set shots-left 0 ]
    if random-float 1 < (0.03 + (0.05 * readiness)) [ set shots-left 2 ]
    set reload-timer round (4 + (1 - readiness) * 8)
  ]
end

to calculate-side-morale
  ifelse any? texians [
    set texian-side-morale mean [morale] of texians
  ] [
    set texian-side-morale 0
  ]

  ifelse any? mexicans [
    set mexican-side-morale mean [morale] of mexicans
  ] [
    set mexican-side-morale 0
  ]
end

to update-battle-phase
  if battle-over? [ stop ]

  if ticks < surprise-ticks [
    set battle-phase "surprise"
  ]

  if ticks >= surprise-ticks and battle-phase = "surprise" [
    set battle-phase "contested"
  ]

  if any? mexicans [
    let routing-rate (count mexicans with [state = "routing"]) / count mexicans
    let collapse-morale-threshold 42 - (mexican-readiness * 12)
    let collapse-routing-threshold 0.14 + (mexican-readiness * 0.16)
    if mexican-side-morale < collapse-morale-threshold or routing-rate > collapse-routing-threshold [
      set battle-phase "collapse"
    ]
  ]

  if battle-phase = "collapse" and count mexicans with [state = "fighting" or state = "shaken"] < (250 + ((1 - mexican-readiness) * 80)) [
    set battle-phase "rout"
  ]

  ;; Mexican victory: strong defense breaks the Texian assault
  if mexican-readiness >= 0.70 and texian-side-morale < 48 and texian-casualties > 350 and count mexicans > 300 [
    set battle-over? true
    set texian-win? false
  ]
  ;; Also win if Texians are nearly wiped out
  if count texians < 100 and count mexicans > 400 [
    set battle-over? true
    set texian-win? false
  ]

  if battle-phase = "rout" and count mexicans < 50 [
    set battle-over? true
    set texian-win? true
  ]

  if not any? texians [
    set battle-over? true
    set texian-win? false
  ]

  if not any? mexicans [
    set battle-over? true
    set texian-win? true
  ]

  if ticks > 650 [
    set battle-over? true
    set texian-win? (count texians > count mexicans)
  ]

  if battle-over? [
    set battle-duration (ticks - combat-start-tick)
    set battle-phase "ended"
  ]
end

to move-texians
  ask texians with [state != "surrendered"] [
    let step 0.45
    if attack-lane = 1 [
      let my-speed-mod (0.85 + (who mod 15) * 0.025)
      set step 0.65 * my-speed-mod
    ]
    if battle-phase = "collapse" [ set step 0.58 if attack-lane = 1 [ set step 0.78 ] ]
    if battle-phase = "rout" [ set step 0.82 if attack-lane = 1 [ set step 1.05 ] ]
    if state = "shaken" [ set step 0.32 ]

    if suppressed-ticks > 0 [
      set step step * 0.6
      set suppressed-ticks suppressed-ticks - 1
    ]

    let bw-x (ridgeline-x + 40)
    ifelse attack-lane = 1 [
      ;; Cavalry: approach east, gradual curve north, with per-unit wobble so no clean line.
      let wobble (random-float 16 - 8)
      if xcor < (bw-x + 4) [
        set heading 90 + wobble + (random-float 14 - 7)
        if ycor > -50 [ set heading 100 + wobble * 0.5 + (random-float 12 - 6) ]
      ]
      if xcor >= (bw-x + 4) and xcor < (bw-x + 30) [
        let progress (xcor - (bw-x + 4)) / 26
        set heading 95 - (progress * 50) + wobble + (random-float 12 - 6)
      ]
      if xcor >= (bw-x + 30) [
        let flank-target min-one-of mexicans with [state != "surrendered" and ycor < 0] [distance myself]
        ifelse flank-target != nobody [
          face flank-target
          set heading heading + (random-float 22 - 11)
        ] [
          set heading 35 + wobble * 0.3 + (random-float 18 - 9)
        ]
      ]
      ;; Break up lines: nudge away from nearby cavalry and add tick-based drift
      let horse-crowd count other texians with [attack-lane = 1] in-radius 3
      if horse-crowd >= 1 [
        set heading heading + (random-float 55 - 25)
      ]
    ] [
      ifelse battle-phase = "surprise" [
        ;; Infantry: advance east with regiment lane bias — 4 distinct groups, broad line
        let lane-y ifelse-value regiment = 0 [ 31 ] [ ifelse-value regiment = 1 [ -2 ] [ -35 ] ]
        let lane-bias (lane-y - ycor) * 0.2
        set heading 88 + lane-bias + (random-float 16 - 8)
        ;; Spread within regiment when packed
        let inf-crowd count other texians with [attack-lane = 0] in-radius 2.8
        if inf-crowd > 2 [
          set heading heading + (random-float 40 - 20)
        ]
      ] [
        ifelse battle-phase = "rout" [
          let prey min-one-of mexicans in-radius 25 [distance myself]
          ifelse prey != nobody [
            face prey
            set heading heading + (random-float 18 - 9)
          ] [
            set heading 90 + (random-float 30 - 15)
            set step step * 0.3
          ]
          let crowd count other texians in-radius 2
          if crowd > 3 [
            set heading heading + (random-float 60 - 30)
          ]
        ] [
          ;; Regiment lane centers (historical: Sherman north, Burleson mid, Millard south)
          let lane-y ifelse-value regiment = 0 [ 31 ] [ ifelse-value regiment = 1 [ -2 ] [ -35 ] ]
          ;; Prefer targets in our sector so regiments don't all converge on one spot
          let active-target min-one-of mexicans with [state = "fighting" or state = "shaken"] [
            distance myself + (0.2 * ((ycor - (31 - 33 * [regiment] of myself)) ^ 2))
          ]
          ifelse active-target != nobody [
            face active-target
            set heading heading + (random-float 14 - 7)
            ;; Pull toward regiment lane — keeps 4 distinct groups, not one blob
            set heading heading + ((lane-y - ycor) * 0.12)
          ] [
            let routing-target min-one-of mexicans with [state = "routing"] [
              distance myself + (0.15 * ((ycor - (31 - 33 * [regiment] of myself)) ^ 2))
            ]
            if routing-target != nobody [
              face routing-target
              set heading heading + (random-float 10 - 5)
              set heading heading + ((lane-y - ycor) * 0.08)
            ]
          ]
          ;; When crowded, spread AWAY from centroid (curl north if above, south if below)
          let inf-crowd count other texians with [attack-lane = 0] in-radius 2.8
          if inf-crowd > 2 [
            let same-regiment other texians with [attack-lane = 0 and regiment = [regiment] of myself] in-radius 2.8
            if any? same-regiment [
              let cy mean [ycor] of same-regiment
              ifelse ycor > cy [
                set heading heading - (10 + random-float 12)
              ] [
                set heading heading + (10 + random-float 12)
              ]
            ]
          ]
        ]
      ]
    ]

    let next-patch patch-ahead step
    if next-patch != nobody [
      ifelse [is-barricade?] of next-patch [
        ask next-patch [
          set barricade-health barricade-health - (2 + random 4)
          if barricade-health <= 0 [
            set is-barricade? false
            set terrain-type "open"
            set move-mod 1
            set cover-mod 0.05
            set pcolor green + 1
          ]
        ]
      ] [
        if [terrain-type] of next-patch != "lake" [
          forward (step * [move-mod] of next-patch)
        ]
      ]
    ]
  ]
end

to move-mexicans
  if not ridgeline-breached? [ stop ]

  ask mexicans with [state != "surrendered"] [
    let step 0.35
    if state = "shaken" [ set step 0.24 ]
    if state = "routing" [ set step 0.78 ]

    ;; Fatigue reduces movement speed (up to -20%)
    set step step * (1 - fatigue-modifier * 0.20)

    if suppressed-ticks > 0 [
      set suppressed-ticks suppressed-ticks - 1
      set step step * 0.6
    ]

    if activation-delay > 0 [
      set activation-delay activation-delay - 1
      set heading heading + (random-float 30 - 15)
    ]

    if activation-delay <= 0 [
      ifelse state = "routing" [
        ;; Routing troops flee east with wide scatter (toward river/marsh/lake)
        set heading 90 + (random-float 60 - 30)
      ] [
        let target min-one-of texians with [state != "surrendered"] [distance myself]
        if target != nobody [
          if battle-phase = "surprise" and random-float 1 < 0.6 [
            set heading 90 + (random-float 120 - 60)
          ]
          if not (battle-phase = "surprise" and random-float 1 < 0.6) [
            face target
          ]
        ]
      ]
    ]

    let next-patch patch-ahead step
    let bw-x (ridgeline-x + 40)
    if next-patch != nobody [
      ifelse [terrain-type] of next-patch = "lake" [
        rt (90 + random 90)
      ] [
        ifelse [is-barricade?] of next-patch or ([pxcor] of next-patch < bw-x and state != "routing") [
          ;; If blocked by breastwork boundary: create depth and spread so no rigid line
          if state != "routing" [
            let mex-crowd count other mexicans in-radius 3
            ifelse mex-crowd > 5 and random-float 1 < 0.35 [
              ;; Fall back east when packed — creates second rank, more natural depth
              set heading 88 + (random-float 24 - 12)
              let back-patch patch-ahead (step * 0.6)
              if back-patch != nobody and [terrain-type] of back-patch != "lake" and [pxcor] of back-patch >= bw-x [
                forward (step * 0.6 * [move-mod] of back-patch)
              ]
            ] [
              ifelse mex-crowd > 2 [
                ;; Spread away from centroid of nearby Mexicans — organic dispersal
                let nearby other mexicans in-radius 3
                if any? nearby [
                  let cx mean [xcor] of nearby
                  let cy mean [ycor] of nearby
                  set heading (towardsxy cx cy) + 180 + (random-float 50 - 25)
                ]
              ] [
                ifelse (who + (ticks mod 7)) mod 3 = 0 [
                  set heading 10 + (random-float 70 - 35)
                ] [
                  ifelse ycor < -10 [
                    set heading 0 + (random-float 55 - 25)
                  ] [
                    set heading 180 + (random-float 55 - 25)
                  ]
                ]
              ]
              let side-patch patch-ahead (step * 0.7)
              if side-patch != nobody and [terrain-type] of side-patch != "lake" and [pxcor] of side-patch >= bw-x [
                forward (step * 0.7 * [move-mod] of side-patch)
              ]
            ]
          ]
        ] [
          forward (step * [move-mod] of next-patch)
        ]
      ]
    ]
  ]
end

to resolve-firefight
  if not ridgeline-breached? [ stop ]

  ask texians with [state = "fighting" or state = "shaken"] [
    ;; Effective rifle range ~12 patches; accuracy drops with distance
    let target one-of ((mexicans in-radius 12) with [state = "fighting" or state = "shaken"])
    if target = nobody and (battle-phase = "collapse" or battle-phase = "rout") [
      set target one-of ((mexicans in-radius 14) with [state = "routing"])
    ]
    if target != nobody [
      let d distance target
      let base-hit 0.22
      if battle-phase = "surprise" [ set base-hit (0.28 + (0.24 * (1 - mexican-readiness))) ]
      if [state] of target = "routing" [ set base-hit base-hit * 1.6 ]
      if state = "shaken" [ set base-hit base-hit * 0.65 ]
      ;; Accuracy falls off with distance
      let range-penalty (d / 14)
      set base-hit base-hit * (1 - range-penalty * 0.6)
      let target-cover [cover-mod] of ([patch-here] of target)
      let hit-prob base-hit + (morale / 340) - (target-cover * 0.55)
      if hit-prob > 0.85 [ set hit-prob 0.85 ]
      if hit-prob < 0.03 [ set hit-prob 0.03 ]
      if random-float 1 < hit-prob [
        ask target [
          set health health - (10 + random 12)
          set morale morale - (3 + random-float 2)
          set suppressed-ticks suppressed-ticks + 1
        ]
      ]
    ]
  ]

  ask mexicans with [(state = "fighting" or state = "shaken") and activation-delay <= 0] [
    let mex-fire-range (4 + round (6 * mexican-readiness))
    let target one-of ((texians in-radius mex-fire-range) with [state = "fighting" or state = "shaken"])
    if target != nobody [
      let d distance target
      let base-hit 0.007 + (mexican-readiness * 0.18)
      set base-hit base-hit * (1 - fatigue-modifier * 0.40)
      if battle-phase = "surprise" [ set base-hit base-hit * (0.08 + (0.45 * mexican-readiness)) ]
      if state = "shaken" [ set base-hit base-hit * 0.70 ]
      let range-penalty (d / (mex-fire-range + 2))
      set base-hit base-hit * (1 - range-penalty * 0.6)
      let target-cover [cover-mod] of ([patch-here] of target)
      let hit-prob base-hit + (morale / 350) - (target-cover * 0.18)
      if hit-prob > 0.62 [ set hit-prob 0.62 ]
      if hit-prob < 0.01 [ set hit-prob 0.01 ]
      if random-float 1 < hit-prob [
        ask target [
          let mex-shot-dmg (1 + random 4 + round (9 * mexican-readiness))
          set health health - mex-shot-dmg
          set morale morale - (1.5 + random-float 1.5)
          set suppressed-ticks suppressed-ticks + 1
        ]
      ]
    ]
  ]
end

to resolve-melee
  ask texians with [state != "surrendered" and state != "routing"] [
    let target one-of ((mexicans in-radius 1.2) with [state = "fighting" or state = "shaken"])
    if target = nobody and (battle-phase = "collapse" or battle-phase = "rout") [
      set target one-of ((mexicans in-radius 1.8) with [state = "routing"])
    ]
    if target != nobody [
      let dmg 10 + random 9
      if battle-phase = "surprise" [ set dmg dmg + (4 + round (4 * (1 - mexican-readiness))) ]
      if [state] of target = "routing" [ set dmg dmg + 8 ]
      ask target [
        set health health - dmg
        set morale morale - (2 + random-float 2)
      ]
    ]
  ]

  ask mexicans with [state != "surrendered" and state != "routing" and activation-delay <= 0] [
    let target one-of ((texians in-radius 1.2) with [state = "fighting" or state = "shaken"])
    if target != nobody [
      let dmg (1 + random 4 + round (9 * mexican-readiness))
      set dmg dmg * (1 - fatigue-modifier * 0.30)
      if battle-phase = "surprise" [ set dmg dmg * (0.25 + (0.35 * mexican-readiness)) ]
      if state = "shaken" [ set dmg dmg * 0.75 ]
      ask target [
        set health health - dmg
        set morale morale - (1.5 + random-float 1.5)
      ]
    ]
  ]
end

to fire-cannons
  if not ridgeline-breached? [ stop ]

  ask mexican-cannons [
    if shots-left > 0 [
      if reload-timer > 0 [ set reload-timer reload-timer - 1 ]
      if reload-timer <= 0 [
        let target one-of texians in-radius 16
        if target != nobody [
          let blast-radius 1.8
          let lethality 0.06 + (mexican-readiness * 0.04)
          if battle-phase = "surprise" [ set lethality lethality * (0.15 + (0.85 * mexican-readiness)) ]

          ask texians with [distance target <= blast-radius] [
            if random-float 1 < lethality [
              set health health - (18 + random 18)
            ]
            set morale morale - (4 + random-float 4)
            set suppressed-ticks suppressed-ticks + 1
          ]

          ask texians with [distance target <= (blast-radius + 2)] [
            set morale morale - 2
          ]

          set shots-left shots-left - 1
          set reload-timer 10
          if shots-left = 0 [ set color gray ]
        ]
      ]
    ]
  ]

  ask texian-cannons [
    set reload-timer reload-timer + 1
    if reload-timer >= 14 and battle-phase != "rout" [
      let target one-of ((mexicans in-radius 22) with [state = "fighting" or state = "shaken"])
      if target != nobody [
        ask mexicans with [distance target <= 2.2 and state != "surrendered"] [
          if random-float 1 < 0.45 [
            set health health - (26 + random 16)
          ]
          set morale morale - (4 + random-float 3)
          set suppressed-ticks suppressed-ticks + 1
        ]
        set reload-timer 0
      ]
    ]
  ]
end

to update-morale-and-state
  ask texians [
    let nearby-enemies count ((mexicans in-radius 2) with [state != "surrendered"])
    let nearby-friends count other texians in-radius 2
    set morale morale - 0.08 + (nearby-friends * 0.03) - (nearby-enemies * 0.04)
    if battle-phase = "surprise" [ set morale morale + 0.12 ]
    if morale > 100 [ set morale 100 ]
    if morale < 0 [ set morale 0 ]

    if morale < 22 and state = "fighting" [ set state "shaken" ]
    if morale > 38 and state = "shaken" and battle-phase != "collapse" and battle-phase != "rout" [
      set state "fighting"
    ]
  ]

  ask mexicans [
    ifelse not ridgeline-breached? [
      ;; Before ridgeline is crossed: Mexicans are unaware, morale is stable
    ] [
      let nearby-enemies count ((texians in-radius 2) with [state != "surrendered"])
      let nearby-friends count ((other mexicans in-radius 2) with [state != "surrendered"])
      let fatigue-decay-penalty fatigue-modifier * 0.25
      set morale morale - (0.16 + ((1 - mexican-readiness) * 0.20) + fatigue-decay-penalty) + (nearby-friends * 0.03) - (nearby-enemies * 0.05)
      if battle-phase = "surprise" [ set morale morale - (0.28 + ((1 - mexican-readiness) * 0.28)) ]
      if activation-delay > 0 [ set morale morale - (0.04 + ((1 - mexican-readiness) * 0.08)) ]
      if battle-phase = "rout" [ set morale morale - 1.1 ]
      if morale > 100 [ set morale 100 ]
      if morale < 0 [ set morale 0 ]

      let shaken-threshold 20 + (fatigue-modifier * 6)
      let routing-threshold 12 + (fatigue-modifier * 5)
      if morale < shaken-threshold and state = "fighting" [ set state "shaken" ]
      if morale < routing-threshold and state != "routing" [ set state "routing" ]
      let rally-threshold 32 + (fatigue-modifier * 5)
      if morale > rally-threshold and state = "shaken" and battle-phase = "contested" [
        set state "fighting"
      ]
    ]
  ]
end

to resolve-rout-and-surrender
  ;; No captures until Texians have actually breached the breastwork area
  let bw-x (ridgeline-x + 40)
  let texians-past-breastwork any? texians with [xcor > bw-x + 4]
  if not texians-past-breastwork [ stop ]

  ask mexicans with [state = "routing" or state = "shaken"] [
    let nearby-texians count texians in-radius 2.5
    let nearby-mexicans count other mexicans in-radius 2.5

    if nearby-texians >= 2 and morale < 18 [
      let surrender-prob 0.06 + (nearby-texians * 0.05) - (nearby-mexicans * 0.02)
      if surrender-prob < 0.01 [ set surrender-prob 0.01 ]
      if surrender-prob > 0.32 [ set surrender-prob 0.32 ]
      if random-float 1 < surrender-prob [
        set mexican-captured mexican-captured + 1
        die
      ]
    ]

    if state = "routing" and battle-phase = "rout" and morale < 24 [
      if random-float 1 < 0.028 [
        set mexican-captured mexican-captured + 1
        die
      ]
    ]

    if state = "routing" and (battle-phase = "rout" or battle-phase = "collapse") [
      let chasers count texians in-radius 4
      if chasers >= 1 and random-float 1 < (0.018 + chasers * 0.015) [
        set mexican-captured mexican-captured + 1
        die
      ]
    ]

    if xcor > max-pxcor - 2 and battle-phase = "rout" [
      if random-float 1 < 0.06 [
        set mexican-captured mexican-captured + 1
        die
      ]
    ]

    if state = "routing" and ([terrain-type] of patch-here = "marsh" or any? neighbors with [terrain-type = "lake"]) [
      let chasers-nearby count texians in-radius 8
      if chasers-nearby >= 1 and random-float 1 < 0.035 [
        set mexican-captured mexican-captured + 1
        die
      ]
    ]
  ]
end

to remove-dead
  ask texians with [health <= 0] [
    set texian-casualties texian-casualties + 1
    die
  ]

  ask mexicans with [health <= 0] [
    set mexican-casualties mexican-casualties + 1
    die
  ]
end

to setup
  clear-all
  set texian-casualties 0
  set mexican-casualties 0
  set texian-captured 0
  set mexican-captured 0
  set battle-over? false
  set battle-duration 0
  set combat-start-tick 0
  set texian-win? false
  set mexican-readiness (mexican-concentration / 100)
  set ridgeline-x -50
  set ridgeline-slope 0
  set ridgeline-breached? false
  set battle-phase "surprise"

  set surprise-ticks 34 - round (mexican-concentration / 6)
  if surprise-ticks < 12 [ set surprise-ticks 12 ]

  setup-patches
  setup-troops
  calculate-side-morale
  reset-ticks
end

to go
  if battle-over? [ stop ]

  update-battle-phase
  if battle-over? [ stop ]

  move-texians
  move-mexicans
  if not ridgeline-breached? and any? texians with [east-of-ridgeline? xcor ycor] [
    set ridgeline-breached? true
    set combat-start-tick ticks
    if mexican-readiness >= 0.75 [
      set battle-phase "contested"
    ]
  ]
  fire-cannons
  resolve-firefight
  resolve-melee
  resolve-rout-and-surrender
  remove-dead
  update-morale-and-state
  calculate-side-morale
  update-battle-phase

  tick
end

to run-experiment [runs]
  let i 0
  while [i < runs] [
    setup
    while [not battle-over?] [
      go
    ]
    show (word "run " (i + 1)
         " concentration=" mexican-concentration
         " cos-fatigue=" cos-fatigue
         " tex-kia=" texian-casualties
         " mex-kia=" mexican-casualties
         " mex-captured=" mexican-captured
         " cos-remaining=" count mexicans with [is-cos-troop?]
         " duration=" battle-duration)
    set i i + 1
  ]
end]]></code>
  <widgets>
    <view x="368" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="-110" height="572" showTickCounter="true" patchSize="2.6" fontSize="10" wrappingAllowedY="false" width="940" tickCounterLabel="ticks" maxPycor="110" updateMode="0" maxPxcor="180" minPxcor="-180"></view>
    <button x="20" y="30" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="setup">setup</button>
    <button x="90" y="30" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55" display="go">go</button>
    <slider x="20" step="1" y="95" max="100" width="250" display="mexican-concentration" height="50" min="0" direction="Horizontal" default="100.0" variable="mexican-concentration"></slider>
    <slider x="20" step="1" y="145" max="100" width="250" display="cos-fatigue" height="50" min="0" direction="Horizontal" default="100.0" variable="cos-fatigue"></slider>
    <monitor x="20" precision="17" y="210" height="60" fontSize="11" width="100" display="Texian Casualties">texian-casualties</monitor>
    <monitor x="135" precision="17" y="210" height="60" fontSize="11" width="100" display="Mexican KIA">mexican-casualties</monitor>
    <monitor x="20" precision="17" y="280" height="60" fontSize="11" width="100" display="Mexican Captured">mexican-captured</monitor>
    <monitor x="135" precision="2" y="280" height="60" fontSize="11" width="100" display="Mex Morale">mexican-side-morale</monitor>
    <monitor x="20" precision="2" y="350" height="60" fontSize="11" width="100" display="Tex Morale">texian-side-morale</monitor>
    <monitor x="135" precision="17" y="350" height="60" fontSize="11" width="100" display="Battle Duration">battle-time</monitor>
    <monitor x="250" precision="17" y="210" height="60" fontSize="11" width="100" display="Cos Remaining">count mexicans with [is-cos-troop?]</monitor>
    <monitor x="250" precision="2" y="280" height="60" fontSize="11" width="100" display="Casualty Ratio">ifelse-value texian-casualties > 0 [ precision (mexican-casualties / texian-casualties) 2 ] [ 0 ]</monitor>
    <monitor x="20" precision="17" y="420" height="60" fontSize="11" width="215" display="Battle Phase">battle-phase</monitor>
  </widgets>
  <info>## WHAT IS IT?

This model is a stochastic, hypothesis-testing simulation of the Battle of San Jacinto.
It asks two questions:
1. If the Mexican force had been more concentrated in defensive positioning, would outcomes have changed?
2. If General Cos' 500 reinforcements had arrived earlier (less fatigued), would that have changed the battle?

## HOW IT WORKS

Two sliders control the key variables:
- `mexican-concentration` controls Mexican defensive readiness. Higher values produce tighter formation, higher starting morale, and shorter reaction delays.
- `cos-fatigue` (0-100) models the exhaustion of General Cos' 500 reinforcement troops who historically arrived after a forced march only hours before the battle. At 100 (historical), they are severely fatigued; at 0 they are fully rested as if they arrived days earlier.

Cos' fatigue affects: starting morale (-30 penalty at max), morale decay rate (+0.25/tick at max), activation delay (+12-14 extra ticks at max), hit probability (-40% at max), melee damage (-30% at max), movement speed (-20% at max), and state transition thresholds (break sooner, harder to rally).

Cos' troops are visually distinguished by a lighter violet color.

Combat is asymmetric and phase-based:
- surprise
- contested
- collapse
- rout

Outcomes include casualties and captures (especially during rout/surrender).

## HOW TO USE IT

1. Set `mexican-concentration` and `cos-fatigue`.
2. Click `setup`.
3. Click `go`.
4. Track KIA, captures, morale, duration, Cos Remaining, and battle phase monitors.

You can also run repeated stochastic trials from the Command Center:

`run-experiment 50`

## THINGS TO NOTICE

- At low concentration, Mexican command delay and morale collapse are more common.
- At high concentration, Mexican resistance is stronger and collapse tends to occur later.
- Captures become a major part of outcomes in rout conditions.
- Cos' troops at high fatigue tend to rout before the main body, potentially dragging overall morale down.
- The `Cos Remaining` monitor shows how quickly Cos' contingent is eliminated or captured.

## THINGS TO TRY

- Sweep concentration from 0 to 100 with cos-fatigue fixed at 100 (historical baseline).
- Then sweep cos-fatigue from 0 to 100 with concentration fixed, to isolate the fatigue effect.
- Run a 2D sweep of both sliders to find interaction effects.
- Compare whether Cos' troops at fatigue 0 + high concentration creates a qualitatively different outcome (stalled collapse, higher Texian casualties).

## EXTENDING THE MODEL

- Add explicit leader agents and localized command radii.
- Add BehaviorSpace experiments and CSV export.
- Model Cos' arrival time as a separate variable (troops arrive mid-battle at very late timing).

## CREDITS AND REFERENCES

Built as a San Jacinto NetLogo classroom model focused on scenario testing.
</info>
